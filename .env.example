# Copiar a .env y configurar una cuenta propia de acceso a la base.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=inventario_tecnosoluciones
DB_USER=
DB_PASSWORD=
# Opcional. Ruta a un certificado CA para una conexión MySQL remota por TLS.
DB_TLS_CA_FILE=
# Máximo por proceso y solicitudes en cola para una conexión libre.
DB_POOL_SIZE=16
DB_QUEUE_LIMIT=256

# Trabajo simultáneo con contraseñas, solicitudes en espera y límite cada 10 minutos
# por dirección IP para cada ruta de autenticación.
AUTH_CONCURRENCY=4
AUTH_QUEUE_LIMIT=256
AUTH_REQUESTS_PER_IP=512

HOST=127.0.0.1
PORT=3000
# URL exacta desde la que se abrirá la aplicación. Usar https:// detrás de un proxy TLS.
APP_ORIGIN=http://127.0.0.1:3000
